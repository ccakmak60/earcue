{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "earcue",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // Audio chunks land here and are read once by the task consumer, then deleted. A lifecycle rule
  // on the bucket ("delete after 7 days") is the backstop for chunks whose processing never
  // succeeded — nothing else reads this bucket, and none of it is user-visible storage.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "earcue-media" }],
  // Producer only. The consumer is its own Worker (infra/task-consumer) so a slow transcription
  // can never occupy a request-serving isolate.
  "queues": { "producers": [{ "binding": "INGEST_QUEUE", "queue": "earcue-ingest" }] },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "earcue" }],
  "observability": { "enabled": true },
  // No `limits.cpu_ms`: the account is on Workers Free, which rejects the field outright
  // (API code 100328) and caps CPU at 10 ms per request regardless. Restore
  // `"limits": { "cpu_ms": 300000 }` the day the account moves to Workers Paid — distill passes
  // and LLM JSON parsing are what need it.
  // A zone route, not a custom domain: the apex already carries externally managed proxied A
  // records (the Workers custom-domain API refuses to take over a hostname that has them, code
  // 100117). A route reuses those records — every request to the zone edge is served by this
  // Worker, which is the origin — and leaves the zone's MX/TXT (spacemail) untouched.
  "routes": [{ "pattern": "earcue.lol/*", "zone_name": "earcue.lol" }],
  "vars": {
    "BETTER_AUTH_URL": "https://earcue.lol",
    "AZURE_OPENAI_BASE_URL": "https://earcue-aoai.openai.azure.com/openai/v1",
    "MODEL_REASON": "earcue-reason",
    // Every decide() call (annotation, the briefing's rank step, the chat's change check). Becomes
    // "earcue-annotate" once that smaller deployment exists; no code change goes with it.
    "MODEL_ANNOTATE": "earcue-reason",
    "MODEL_VISION": "earcue-vision",
    "MODEL_TRANSCRIBE": "earcue-transcribe",
    "MODEL_EMBED": "earcue-embed",
    "BILLING_ENABLED": "0",
    // Billing off means every account is on the free plan (src/lib/server/plans.ts), so this total
    // across all users and models is what bounds a crowd of sign-ups. Raise it against the
    // authorized /api/health `llm` figures.
    "DAILY_TOKEN_CEILING": "5000000"
  },
  // `localConnectionString` is a placeholder that nothing connects to. `opennextjs-cloudflare
  // build`/`deploy` start a local platform proxy that refuses to run without one, so without it
  // `npm run deploy` (locally and in CI) fails. `npm run preview` does connect through it: set
  // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE to a real Postgres URL, which wins.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "d2063368944f42e0986f484619ffa810",
      "localConnectionString": "postgres://placeholder@localhost:5432/placeholder"
    }
  ]
}
