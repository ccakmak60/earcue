DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
CRON_SECRET=
NVIDIA_API_KEY=
GEMINI_API_KEY=
BILLING_ENABLED= # ON HOLD — keep 0. Polar integration is intact but inert; 1 re-enables real gating.
POLAR_ACCESS_TOKEN= # required only when BILLING_ENABLED=1
POLAR_WEBHOOK_SECRET= # required only when BILLING_ENABLED=1
POLAR_PRODUCT_ID_PRO= # required only when BILLING_ENABLED=1
CONNECTOR_ENC_KEY=
GOOGLE_CLIENT_ID= # unset: Google sign-in button and Google connector are hidden
GOOGLE_CLIENT_SECRET= # unset: Google sign-in button and Google connector are hidden
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
WAHA_BASE_URL= # unset: WhatsApp connector hidden. e.g. http://localhost:3001
WAHA_API_KEY= # WAHA_API_KEY from the WAHA container's .env, sent as X-Api-Key
WAHA_WEBHOOK_BASE_URL= # default: BETTER_AUTH_URL. Set to a URL WAHA can reach, e.g. http://host.docker.internal:3000
POLAR_SERVER= # default: production
NIM_BASE_URL= # default: https://integrate.api.nvidia.com/v1
GEMINI_BASE_URL= # default: https://generativelanguage.googleapis.com/v1beta
MODEL_TRANSCRIBE= # default: nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
MODEL_VISION= # default: meta/llama-3.2-11b-vision-instruct
MODEL_REASON= # default: minimaxai/minimax-m3
SWEEP_LIMIT= # default: 200
SWEEP_BUDGET_MS= # default: 50000
CONTEXT_RETENTION_DAYS= # default: 30
ASSIST_MIN_INTERVAL_MS= # default: 180000
MODEL_EMBED= # default: gemini-embedding-001
IMPORT_LOOKBACK_DAYS= # default: 180
DISTILL_BATCH= # default: 300
MEMORY_DEDUP_SIM= # default: 0.9
RECALL_CANDIDATES= # default: 30
RECALL_RRF_K= # default: 60
MEMORY_FORGET_FLOOR= # default: 0.05
DREAM_MIN_MEMORIES= # default: 12
EPISODE_GAP_MS= # default: 900000
ADMIN_EMAIL= # only read by: npm run seed:admin
ADMIN_PASSWORD= # only read by: npm run seed:admin
