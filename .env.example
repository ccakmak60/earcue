DATABASE_URL= # postgresql://earcue:<pw>@<server>.postgres.database.azure.com:5432/earcue?sslmode=require
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
CRON_SECRET=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL= # https://<resource>.openai.azure.com/openai/v1
BILLING_ENABLED= # ON HOLD — keep 0. Polar integration is intact but inert; 1 re-enables real gating.
# With 0, entitlement comes only from users.unlimited (npm run seed:admin). Billing off is not billing-free:
# sign-up is public and inference is billed to the Azure account.
POLAR_ACCESS_TOKEN= # required only when BILLING_ENABLED=1
POLAR_WEBHOOK_SECRET= # required only when BILLING_ENABLED=1
POLAR_PRODUCT_ID_PRO= # required only when BILLING_ENABLED=1
CONNECTOR_ENC_KEY=
TURNSTILE_SECRET_KEY= # both Turnstile vars unset: public sign-up has no captcha
TURNSTILE_SITE_KEY= # public site key, rendered into the sign-up form
GOOGLE_CLIENT_ID= # unset: Google sign-in button and Google connector are hidden
GOOGLE_CLIENT_SECRET= # unset: Google sign-in button and Google connector are hidden
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
POLAR_SERVER= # default: production
MODEL_TRANSCRIBE= # default: earcue-transcribe
MODEL_VISION= # default: earcue-vision
MODEL_REASON= # default: earcue-reason
DAILY_TOKEN_CEILING= # default: 0 (off). Total Azure OpenAI tokens/day across all users; past it, inference returns 503
CONTEXT_RETENTION_DAYS= # default: 30
MODEL_EMBED= # default: earcue-embed
IMPORT_LOOKBACK_DAYS= # default: 180
DISTILL_BATCH= # default: 300
EMBED_ITEMS_PER_PASS= # default: 500 (context items embedded per distill pass, newest first; npm run reembed clears a large backlog)
MEMORY_DEDUP_SIM= # default: 0.72 (cosine at/above which a produced memory updates the nearest one instead of inserting)
RECALL_CANDIDATES= # default: 30
RECALL_RRF_K= # default: 60
RECALL_MIN_SIM= # default: 0.15 (cosine floor; below it a memory is not a recall candidate)
MEMORY_FORGET_FLOOR= # default: 0.05
DREAM_MIN_MEMORIES= # default: 12
EPISODE_GAP_MS= # default: 900000
HEALTH_STALE_BROWSER_HOURS= # default: 48 (authorized /api/health: no completed extension history sync)
HEALTH_STALE_BOOKMARKS_HOURS= # default: 192 (extension syncs bookmarks weekly)
HEALTH_STALE_IMPORT_MINUTES= # default: 60 (an import left in status running)
PAGE_TRACE_MS= # default: 60000 (dwell ms at/above which a captured page also becomes a Day-view trace)
DISTILL_PAGE_CHARS= # default: 1500 (excerpt length given to the distiller for a captured page)
DISTILL_PAGE_ITEMS= # default: 40 (how many captured pages per distill pass get the longer excerpt)
HEALTH_STALE_PAGES_HOURS= # default: 48 (authorized /api/health: no page captured)
ADMIN_EMAIL= # only read by: npm run seed:admin
ADMIN_PASSWORD= # only read by: npm run seed:admin
ADMIN_NAME= # only read by: npm run seed:admin (default: the email local part)
