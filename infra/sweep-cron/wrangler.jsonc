{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "earcue-sweep-cron",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  // Hourly, not nightly: the route only picks a user whose own clock has passed REVIEW_LOCAL_HOUR,
  // so each day review is generated after that user's evening instead of at one fixed UTC hour.
  "triggers": { "crons": ["0 * * * *"] },
  "queues": { "producers": [{ "binding": "SWEEP_QUEUE", "queue": "earcue-sweep" }] },
  "vars": { "SWEEP_URL": "https://earcue.lol/api/cron/review-sweep" }
}
