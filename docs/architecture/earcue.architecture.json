  "cards": [
    {
      "dot": "cyan",
      "title": "Live loop",
      "items": [
        "Capture flushes audio chunks and frames; the pipeline posts them to ingest",
        "Chunks park in R2; earcue-task-consumer transcribes them into trace rows"
      ]
    },
    {
      "dot": "emerald",
      "title": "Memory",
      "items": [
        "Neon Postgres holds traces, captured page text and pgvector memories",
        "earcue-sweep-cron fans each user's review and distill out hourly; recall fuses vector and text with RRF"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust",
      "items": [
        "requireUser, assertEntitled, consume guard every endpoint",
        "The extension uses bearer tokens; Polar writes the plan cache by webhook only"
      ]
    }
  ]
