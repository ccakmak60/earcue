{
  "manifest_version": 3,
  "name": "earcue context",
  "version": "1.0.0",
  "description": "Keeps earcue's personal knowledge base fed with your browsing history, bookmarks, and the page contents you actually read.",
  "permissions": ["history", "bookmarks", "storage", "alarms", "scripting"],
  "optional_host_permissions": ["http://localhost/*", "http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "options.html",
  "action": { "default_popup": "popup.html" }
}
