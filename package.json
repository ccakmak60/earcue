{
  "name": "earcue",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:doctor": "node scripts/dev-doctor.mjs",
    "dev:seed": "node scripts/dev-seed.mjs",
    "dev:token": "node scripts/dev-token.mjs",
    "dev:up": "node scripts/dev-doctor.mjs && next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "migrate": "node scripts/migrate.mjs",
    "migrate:baseline": "node scripts/migrate.mjs --baseline",
    "reembed": "tsx --conditions=react-server scripts/reembed-memories.ts",
    "seed:admin": "tsx --conditions=react-server scripts/seed-admin.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --keep-vars --var COMMIT_SHA:$(git rev-parse HEAD)",
    "deploy:consumer": "wrangler deploy -c infra/task-consumer/wrangler.jsonc",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@polar-sh/better-auth": "^1.8.4",
    "@polar-sh/sdk": "^0.47.1",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "client-only": "^0.0.1",
    "clsx": "^2.1.1",
    "kysely": "^0.29.6",
    "lucide-react": "^1.45.0",
    "next": "^16.3.5",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.83.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.134.0"
  }
}
